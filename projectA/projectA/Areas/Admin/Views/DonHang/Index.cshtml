@model IEnumerable<HoaDon>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
            color: #555;
        }
        .invoice-header {
            display: flex;
            justify-content: space-between;
        }
        .company-details, .invoice-details {
            text-align: right;
        }
        .invoice-title {
            font-size: 24px;
            color: #333;
            font-weight: bold;
        }
        .invoice-items table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
        }
        .invoice-items table th, .invoice-items table td {
            padding: 10px;
            text-align: left;
            border: 1px solid #eee;
        }
        .invoice-items table th {
            background: #f7f7f7;
        }
        .total-row {
            font-weight: bold;
            border-top: 2px solid #333;
        }
        .text-right {
            text-align: right;
        }
    </style>
</head>
<body>
    <div class="invoice-box">
        <div class="invoice-header">
            <div class="company-details">
                <p><strong>BCTM For Life</strong></p>
                <p>Biên Hòa, Đồng Nai</p>
                
                <p>Email: 182240869@dntu.edu.vn</p>
                <p>Sđt: +84 967 630 387 </p>
            </div>
            <div class="invoice-details">
                <p class="invoice-title">Chuyến hàng</p>
                <p><strong>Mã Hóa Đơn #:</strong> DHDT</p>
                <p><strong>Ngày:</strong> @DateTime.Now</p>
            </div>
        </div>



        <div class="invoice-items">
            <table>
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Id đơn hàng</th>
                        <th>Tên người đặt</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ</th>
                        <th>Trạng thái đơn hàng</th>
                        <th>Thành Tiền</th>
                        <th>Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var counter = 1; // Initialize counter for automatic numbering
                    }
                    @foreach(var item in Model)
                    {
                        <tr>
                        <td>@counter</td>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Address</td>
                        <td>@item.OrderStatus</td>
                            <td>@item.Total.ToString("N0")đ</td>
                        <td>
                                <a asp-area="Admin" asp-controller="DonHang" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Xóa</a>
                        </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>

        <p>Cám ơn vì đã sử dụng dịch vụ !</p>
    </div>
</body>
</html>
